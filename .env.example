# Folder scanned for *.step / *.stp files (default: ./models)
CAD_DATA_ROOT=models
# Folder for computed scenes, snapshots and shared pages (default: ./runtime)
STUDIO_RUNTIME=runtime
# Time limit per model, in seconds
STUDIO_TIMEOUT_S=1800
# Verifier variant used by exploded-view-verifier: 2.2, 2.3 (default), 2.3.1 or 2.4
ORACLE_VERSION=2.3
# AutoMate part STEP folder, if it is not <root>/automate_step next to automate_asm/
AUTOMATE_STEP_DIR=
